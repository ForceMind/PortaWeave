SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 5.0
CLANG_ENABLE_MODULES = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_INCLUDE_PATHS = $(inherited) "$(SRCROOT)/../../include"
LIBRARY_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../../target/$(PW_RUST_TARGET)/release"
PW_RUST_TARGET = aarch64-apple-darwin
OTHER_LDFLAGS = $(inherited) "$(SRCROOT)/../../target/$(PW_RUST_TARGET)/release/libportaweave_native.a" -liconv -lresolv -framework Security -framework CoreFoundation
